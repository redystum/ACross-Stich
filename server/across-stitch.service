[Unit]
Description=Across Stitch Server (Raspberry Pi)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/across_stitch/server
ExecStart=/home/pi/.bun/bin/bun run server.ts
Restart=always
RestartSec=5
Environment=PORT=3000
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
